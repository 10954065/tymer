# Copy to .env.local (development) and fill in real values. Never commit real secrets.
# See ENVIRONMENT_VARIABLES.md for a description of every variable.

# --- Database -------------------------------------------------------------
# Application traffic: Neon *pooled* connection string (host contains "-pooler").
DATABASE_URL=postgres://smartliving:smartliving_local@localhost:5433/smartliving_dev
# Migrations / backups: Neon *direct* (unpooled) connection string.
DATABASE_URL_UNPOOLED=postgres://smartliving:smartliving_local@localhost:5433/smartliving_dev
# Automated tests only (local Docker database, never production).
TEST_DATABASE_URL=postgres://smartliving:smartliving_local@localhost:5433/smartliving_test
DB_POOL_MAX=5

# --- Auth -----------------------------------------------------------------
# Session lifetime in hours.
SESSION_TTL_HOURS=12
# Initial owner account used by `npm run db:seed` (change the password on first login).
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=change-me-now-please
SEED_OWNER_NAME=Shop Owner

# --- File storage (product images, expense attachments) --------------------
# "local" stores under ./uploads (development only). "s3" uses any S3-compatible bucket (e.g. Cloudflare R2).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Operations -----------------------------------------------------------
# Shared secret used by the scheduled cleanup job and backup workflow to call internal endpoints.
CRON_SECRET=
# Database storage budget in MB used for the internal usage warnings (verify current Neon plan limits).
DB_STORAGE_LIMIT_MB=512
